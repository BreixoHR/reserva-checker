{
  "manifest_version": 3,
  "name": "Reserva Checker",
  "version": "3.0.0",
  "description": "Verifica contra el CRM que la fecha elegida en la web de entradas coincide con la reserva del cliente antes de comprar.",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/demo/*", "http://127.0.0.1/demo/*"],
      "js": ["lib/date.js", "content/adapters.js", "content/main.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Reserva Checker"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
